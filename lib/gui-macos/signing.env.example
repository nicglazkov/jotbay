# Copy to signing.env and fill in. That file is gitignored.
#
# Only needed to produce a signed, notarizable app. Without it the build falls
# through to ad-hoc signing, which works fine for running locally and is what
# CI does — Apple will not notarize the result, and macOS forgets granted
# permissions on every rebuild, but nothing else changes.
#
# Everything here identifies *you* as the publisher, which is why it is not
# checked in: a bundle identifier and a Team ID belong to whoever ships the app,
# not to the project.

# Exactly as `security find-identity -v -p codesigning` prints it.
JOTBAY_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# The ten-character Team ID, also visible in the identity above.
JOTBAY_TEAM_ID="TEAMID1234"

# Reverse-DNS prefix for the bundle identifier. Must be unique to you; the
# default in project.yml is com.example, which Apple will not notarize.
JOTBAY_BUNDLE_PREFIX="com.example"

# The `xcrun notarytool store-credentials` profile name, used by package.sh.
JOTBAY_NOTARY_PROFILE="notary"
